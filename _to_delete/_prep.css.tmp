
/* ——— نافذة تجهيز الصورة ——— */
.sd-modal.sd-prep { width: min(820px, 100%); }
.sd-prep-body { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 12px; }
.sd-prep-stage { flex: 0 1 auto; max-width: 100%; }
.sd-prep-view {
  max-width: 100%; overflow: auto; border-radius: 12px; border: 1px solid var(--sd-line);
  background-color: #e9e9ef;
  background-image: linear-gradient(45deg, #cfcfd8 25%, transparent 25%), linear-gradient(-45deg, #cfcfd8 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #cfcfd8 75%), linear-gradient(-45deg, transparent 75%, #cfcfd8 75%);
  background-size: 16px 16px; background-position: 0 0, 0 8px, 8px -8px, -8px 0;
  display: flex;
}
.sd-prep-canvas { position: relative; margin: auto; flex: none; touch-action: none; }
.sd-prep-canvas canvas { display: block; }
.sd-prep-crop {
  position: absolute; border: 2px solid #fff; box-shadow: 0 0 0 9999px rgba(10, 12, 40, .55); cursor: move; touch-action: none;
}
.sd-h { position: absolute; width: 14px; height: 14px; background: #fff; border: 2px solid var(--sd-accent); border-radius: 3px; }
.sd-h-nw { left: -8px; top: -8px; cursor: nwse-resize; } .sd-h-se { right: -8px; bottom: -8px; cursor: nwse-resize; }
.sd-h-ne { right: -8px; top: -8px; cursor: nesw-resize; } .sd-h-sw { left: -8px; bottom: -8px; cursor: nesw-resize; }
.sd-h-n { left: calc(50% - 7px); top: -8px; cursor: ns-resize; } .sd-h-s { left: calc(50% - 7px); bottom: -8px; cursor: ns-resize; }
.sd-h-e { right: -8px; top: calc(50% - 7px); cursor: ew-resize; } .sd-h-w { left: -8px; top: calc(50% - 7px); cursor: ew-resize; }
.sd-prep-view { overflow: auto; }
.sd-prep-zoom { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
.sd-prep-zoom input { flex: 1; accent-color: var(--sd-accent); }
.sd-prep-zoom button {
  width: 28px; height: 28px; border-radius: 50%; border: 0; background: var(--sd-surface-2); color: var(--sd-ink);
  font-size: 18px; line-height: 1; cursor: pointer;
}
.sd-prep-side { flex: 1 1 240px; min-width: 220px; }
.sd-prep-side > label { margin: 14px 0 8px !important; }
.sd-prep-tol { margin-top: 10px; }
.sd-prep-tol small { display: block; color: var(--sd-dim); font-size: 12px; margin: 4px 0; }
.sd-ratios { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
.sd-ratios button {
  display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 8px 4px; border-radius: 10px;
  border: 1px solid var(--sd-line); background: var(--sd-bg); color: var(--sd-dim); cursor: pointer; font: inherit; font-size: 12px;
}
.sd-ratios button.on { border-color: var(--sd-accent); color: var(--sd-ink); background: var(--sd-surface-2); }
.sd-ratios i { display: block; width: 26px; height: 22px; border: 1.5px solid currentColor; border-radius: 3px; }
.sd-ratios i[style] { height: auto; width: 26px; }
.sd-prep-actions { justify-content: flex-end; }
@media (max-width: 560px) { .sd-prep-view { width: 100% !important; height: 320px !important; } }
